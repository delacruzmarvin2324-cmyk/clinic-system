{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter: Run Web",
            "type": "process",
            "command": "flutter",
            "args": [
                "run",
                "-d",
                "web-server",
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "8080"
            ],
            "options": {
                "cwd": "${workspaceFolder}/mobile"
            },
            "problemMatcher": []
        }
    ]
}